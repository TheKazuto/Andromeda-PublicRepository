{
  "name": "encrypt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Encrypt engine backend - REST API exposing Encrypt FHE primitives and high-level private wallet/transaction operations on Solana devnet",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured yet'",
    "test": "node --import tsx --test src/routes/decision.test.ts"
  },
  "dependencies": {
    "@encrypt.xyz/pre-alpha-solana-client": "^0.1.1",
    "@hono/node-server": "^2.0.1",
    "@hono/zod-validator": "^0.7.6",
    "@solana-program/compute-budget": "^0.15.0",
    "@solana-program/system": "^0.12.0",
    "@solana/kit": "^6.8.0",
    "@upstash/redis": "^1.37.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.17",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
