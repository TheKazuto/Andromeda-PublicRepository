{
  "name": "ika-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/cmd/migrate.js",
    "migrate:dev": "tsx scripts/run-migrations.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@mysten/bcs": "^2.0.5",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@polkadot/util-crypto": "^14.0.3",
    "@simplewebauthn/server": "^13.3.0",
    "@solana/kit": "^6.8.0",
    "@solana/web3-compat": "^0.0.21",
    "bcrypt": "^6.0.0",
    "bech32": "^2.0.0",
    "bs58": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "nodemailer": "^8.0.7",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
