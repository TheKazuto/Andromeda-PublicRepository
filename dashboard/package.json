{
  "name": "andromeda-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pages:deploy": "next build && wrangler pages deploy out --project-name=andromeda-dashboard",
    "pages:dev": "next build && wrangler pages dev out"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "lucide-react": "1.14.0",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "wrangler": "^4.87.0"
  },
  "packageManager": "npm@10.8.2"
}
