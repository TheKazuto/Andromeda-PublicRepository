# Cloudflare Pages — security headers for the Andromeda dashboard.
#
# Next.js static export does not emit response headers itself, so this file
# is the single source of truth for the dashboard's HTTP security posture.
# Cloudflare Pages reads `_headers` straight from the build output (the
# `public/` directory is copied to `out/` by Next.js during `next build`).
#
# When the API URLs change, update `connect-src` below.

# ----- Baseline for every dashboard route -----
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.andromedainfra.pro https://auth.andromedainfra.pro https://cloudflareinsights.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# ----- Authenticated dashboard pages: never cache HTML -----
# Static export ships one HTML per route; if Cloudflare cached
# /admin/users.html with a logged-in operator's data baked in, the next
# visitor would see it. The static export injects no PII server-side
# (Next.js client-side hydration only), but no-store is the right
# defence-in-depth posture for any logged-in surface.
/admin/*
  Cache-Control: no-store
/account/*
  Cache-Control: no-store
/billing/*
  Cache-Control: no-store

# ----- Static assets: cache hard at the edge -----
# Hashed asset names mean the cache key changes on every deploy.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/static/*
  Cache-Control: public, max-age=31536000, immutable
